@startuml

title Сервисный центр по ремонту бытовой техники\nДиаграмма классов - вариант 16

skinparam classAttributeIconSize 0

class Source {
    + id: int
    + generated_count: int
    + min_interval: float
    + max_interval: float

    + generate_request(current_time: float): Request
    + generate_next_interval(): float
}

note right of Source
ИБ - бесконечный источник
ИЗ2 - равномерный закон
интервалов между заявками
end note

class Request {
    + source_id: int
    + request_number: int
    + generation_time: float
    + buffer_entry_time: Optional~float~
    + service_start_time: Optional~float~
    + service_end_time: Optional~float~
    + status: RequestStatus

    + get_waiting_time(): float
    + get_service_time(): float
    + get_system_time(): float
}

enum RequestStatus {
    CREATED
    BUFFERED
    IN_SERVICE
    COMPLETED
    REJECTED
}

class PlacementDispatcher {
    + buffer: Buffer
    + selection_dispatcher: SelectionDispatcher
    + statistics: StatisticsCollector
    + log: Callable

    + handle_request(request: Request, current_time: float): None
}

class Buffer {
    + capacity: int
    + slots: list
    + insertion_pointer: int
    - _entry_counter: int
    - _entry_order: dict

    + put_by_ring(request: Request, current_time: float): BufferPutResult
    + replace_oldest(request: Request, current_time: float): Request
    + take_lifo(): Optional~Request~
    + is_empty(): bool
    + is_full(): bool
    + get_requests(): List~Request~
    + get_insertion_pointer(): int

    - _store(index: int, request: Request, current_time: float): None
}

note right of Buffer
Д1ОЗ1 - постановка по кольцу

Д1ОО3 - удаление самой
старой заявки при переполнении

Д2Б2 - выбор по LIFO
end note

enum BufferPutResult {
    STORED
    FULL
}

class SelectionDispatcher {
    + buffer: Buffer
    + master_pool: MasterPool
    + event_calendar: EventCalendar
    + statistics: StatisticsCollector
    + log: Callable

    + try_start_service(request: Request, current_time: float): bool
    + on_master_released(master: Master, current_time: float): None
}

class MasterPool {
    + masters: List~Master~
    + selection_pointer: int

    + find_free_by_ring(): Optional~Master~
    + has_free_master(): bool
    + get_masters(): List~Master~
    + get_selection_pointer(): int
}

note right of MasterPool
Д2П2 - выбор свободного
прибора по кольцу
end note

class Master {
    + id: int
    + mean_service_time: float
    + busy: bool
    + current_request: Optional~Request~
    + busy_time: float
    + completed_count: int

    + start_service(request: Request, current_time: float): float
    + finish_service(current_time: float): Request
    + is_free(): bool
    + generate_service_time(): float
}

note right of Master
ПЗ1 - экспоненциальный закон
времени обслуживания
end note

class Event {
    + time: float
    + type: EventType
    + request: Optional~Request~
    + master: Optional~Master~
}

enum EventType {
    REQUEST_GENERATED
    SERVICE_COMPLETED
}

class EventCalendar {
    + events: list
    - _counter: count

    + add_event(event: Event): None
    + get_next_event(): Event
    + is_empty(): bool
    + get_events(): List~Event~
}

note right of EventCalendar
Хранит будущие события
в порядке модельного времени.

Используется в пошаговом
и автоматическом режимах.
end note

class StatisticsCollector {
    + generated_count: int
    + rejected_count: int
    + completed_count: int
    + total_waiting_time: float
    + total_service_time: float
    + total_system_time: float
    + total_waiting_time_squared: float
    + total_service_time_squared: float

    + record_generated(request: Request): None
    + record_buffered(request: Request): None
    + record_rejected(request: Request): None
    + record_service_start(request: Request): None
    + record_service_end(request: Request): None
    + get_rejection_probability(): float
    + build_summary(): dict
}

class SummaryReport {
    + summary: dict
    + masters: List~Master~
    + total_time: float
    + source_id: int

    + print_report(): None
    + print_source_table(): None
    + print_master_table(): None
}

note right of SummaryReport
ОР1 - две сводные таблицы:
характеристики источников
и характеристики приборов.
end note

class Simulation {
    + max_requests: int
    + current_time: float
    + step_number: int
    + sources: List~Source~
    + event_calendar: EventCalendar
    + placement_dispatcher: PlacementDispatcher
    + selection_dispatcher: SelectionDispatcher
    + buffer: Buffer
    + master_pool: MasterPool
    + statistics: StatisticsCollector

    - _step_actions: List~str~
    - _show_actions: bool

    + initialize(): None
    + step(show_state: bool): bool
    + run_step_mode(): None
    + run_automatic_mode(): dict
    + show_current_state(description: str): None
    + show_summary(): None
    + log_action(message: str): None

    + process_event(event: Event): str
    + process_request_generated(event: Event): str
    + process_service_completed(event: Event): str
    + schedule_next_arrival(source: Source): None
}

note right of Simulation
ОД1 - пошаговый режим:
состояние системы,
кольцевые указатели,
действия диспетчеров,
календарь событий,
текущая статистика.
end note

class "automatic_runner.py" as AutomaticRunner <<module>> {
    + calculate_required_requests(probability: float): Optional~int~
    + run_with_accuracy(...): Simulation
}

note right of AutomaticRunner
Автоматический подбор
количества заявок.

Относительная точность: 10%
Доверительная вероятность: 0.9

Повторное моделирование
с проверкой критерия остановки.
end note

Source --> Request : creates
Request --> RequestStatus

PlacementDispatcher --> Buffer
PlacementDispatcher --> SelectionDispatcher
PlacementDispatcher --> StatisticsCollector

SelectionDispatcher --> Buffer
SelectionDispatcher --> MasterPool
SelectionDispatcher --> EventCalendar
SelectionDispatcher --> StatisticsCollector

MasterPool "1" *-- "1..*" Master
Master --> "0..1" Request : services

Buffer "1" o-- "0..*" Request
Buffer --> BufferPutResult

Event --> EventType
Event --> "0..1" Request
Event --> "0..1" Master

EventCalendar "1" *-- "0..*" Event

Simulation "1" o-- "1" Source
Simulation --> EventCalendar
Simulation --> PlacementDispatcher
Simulation --> SelectionDispatcher
Simulation --> Buffer
Simulation --> MasterPool
Simulation --> StatisticsCollector

Simulation ..> SummaryReport : creates
SummaryReport --> Master : uses statistics

AutomaticRunner ..> Simulation : creates and runs

@enduml
