
@startuml

title Сервисный центр по ремонту бытовой техники\nДиаграмма классов - вариант 16

skinparam classAttributeIconSize 0

class Source {
    - id: int
    - generatedCount: int

    + generateRequest(currentTime: double): Request
    + generateNextInterval(): double
}

note right of Source
ИБ - бесконечный источник
ИЗ2 - равномерный закон
интервалов между заявками
end note

class Request {
    - sourceId: int
    - requestNumber: int
    - generationTime: double
    - bufferEntryTime: double
    - serviceStartTime: double
    - serviceEndTime: double
    - status: RequestStatus

    + getWaitingTime(): double
    + getServiceTime(): double
    + getSystemTime(): double
}

enum RequestStatus {
    CREATED
    BUFFERED
    IN_SERVICE
    COMPLETED
    REJECTED
}

class PlacementDispatcher {
    - buffer: Buffer
    - selectionDispatcher: SelectionDispatcher
    - statistics: StatisticsCollector

    + handleRequest(request: Request, currentTime: double): void
}

class Buffer {
    - capacity: int
    - slots: Request[]
    - insertionPointer: int

    + putByRing(request: Request, currentTime: double): BufferPutResult
    + replaceOldest(request: Request, currentTime: double): Request
    + takeLIFO(): Request
    + isEmpty(): boolean
    + isFull(): boolean
    + getRequests(): List~Request~
    + getInsertionPointer(): int

    - findOldest(): Request
}

note right of Buffer
Д1ОЗ1 - постановка по кольцу

Д1ОО3 - удаление самой
старой заявки при переполнении

Д2Б2 - выбор по LIFO
end note

enum BufferPutResult {
    STORED
    FULL
}

class SelectionDispatcher {
    - buffer: Buffer
    - masterPool: MasterPool
    - eventCalendar: EventCalendar
    - statistics: StatisticsCollector

    + tryStartService(request: Request, currentTime: double): boolean
    + onMasterReleased(master: Master, currentTime: double): void

    - selectRequestFromBuffer(): Request
    - selectFreeMaster(): Master
    - scheduleServiceCompletion(master: Master, request: Request, completionTime: double): void
}

class MasterPool {
    - masters: List~Master~
    - selectionPointer: int

    + findFreeByRing(): Master
    + hasFreeMaster(): boolean
    + getMasters(): List~Master~
    + getSelectionPointer(): int
}

note right of MasterPool
Д2П2 - выбор свободного
прибора по кольцу
end note

class Master {
    - id: int
    - busy: boolean
    - currentRequest: Request
    - busyTime: double

    + startService(request: Request, currentTime: double): double
    + finishService(currentTime: double): Request
    + isFree(): boolean
    + getCurrentRequest(): Request
    + getId(): int

    - generateServiceTime(): double
}

note right of Master
ПЗ1 - экспоненциальный закон
времени обслуживания
end note

class Event {
    - time: double
    - type: EventType
    - request: Request
    - master: Master
}

enum EventType {
    REQUEST_GENERATED
    SERVICE_COMPLETED
}

class EventCalendar {
    - events: PriorityQueue~Event~

    + addEvent(event: Event): void
    + getNextEvent(): Event
    + isEmpty(): boolean
}

note right of EventCalendar
Хранит будущие события
в порядке модельного времени.

Используется в пошаговом
и автоматическом режимах.
end note

class StatisticsCollector {
    - generatedCount: int
    - rejectedCount: int
    - completedCount: int
    - totalWaitingTime: double
    - totalServiceTime: double

    + recordGenerated(request: Request): void
    + recordBuffered(request: Request): void
    + recordRejected(request: Request): void
    + recordServiceStart(request: Request): void
    + recordServiceEnd(request: Request): void

    + getRejectionProbability(): double
    + buildSummary(): SummaryReport
}

class SummaryReport {
    + getRequestTable(): Table
    + getMasterTable(): Table
}

note right of SummaryReport
ОР1 - две сводные таблицы
в автоматическом режиме
end note

class Simulation {
    - currentTime: double
    - sources: List~Source~
    - eventCalendar: EventCalendar
    - placementDispatcher: PlacementDispatcher
    - selectionDispatcher: SelectionDispatcher
    - buffer: Buffer
    - masterPool: MasterPool
    - statistics: StatisticsCollector

    + initialize(): void
    + step(): void
    + runStepMode(): void
    + runAutomaticMode(): void
    + showCurrentState(): void

    - processEvent(event: Event): void
    - processRequestGenerated(event: Event): void
    - processServiceCompleted(event: Event): void
    - scheduleNextArrival(source: Source): void
}

Source --> Request : creates
Request --> RequestStatus

PlacementDispatcher --> Buffer
PlacementDispatcher --> SelectionDispatcher
PlacementDispatcher --> StatisticsCollector

SelectionDispatcher --> Buffer
SelectionDispatcher --> MasterPool
SelectionDispatcher --> EventCalendar
SelectionDispatcher --> StatisticsCollector

MasterPool "1" *-- "1..*" Master
Master --> Request : services

Buffer "1" o-- "0..*" Request
Buffer --> BufferPutResult

Event --> EventType
Event --> Request
Event --> Master

EventCalendar "1" *-- "0..*" Event

StatisticsCollector --> SummaryReport : creates

Simulation "1" o-- "1..*" Source
Simulation --> EventCalendar
Simulation --> PlacementDispatcher
Simulation --> SelectionDispatcher
Simulation --> Buffer
Simulation --> MasterPool
Simulation --> StatisticsCollector

@enduml
