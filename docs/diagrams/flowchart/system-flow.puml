@startuml

scale max 3500*3500

title Сервисный центр по ремонту бытовой техники\nБлок-схема с дорожками - вариант 16

|main.py|
start

:Выбрать режим моделирования;
:Ввести параметры системы;
:Настроить генератор случайных чисел (seed);

if (Автоматический режим?) then (да)

    |Автоматический подбор|
    :Установить начальное количество заявок N;
    :Установить относительную точность 10%;
    :Установить доверительную вероятность 0.9;

else (нет)

    |main.py|
    :Установить количество заявок\nдля пошагового режима;

endif

|Симуляция|

repeat

    :Инициализировать новый прогон;
    :Установить начальное модельное время 0;
    :Создать источник, буфер, мастеров,\nдиспетчеры и сборщик статистики;

    |Источник|
    :Сгенерировать первый интервал\n[ИЗ2 - равномерный закон];

    |Календарь событий|
    :Добавить первое событие REQUEST_GENERATED;

    |Симуляция|

    if (Пошаговый режим?) then (да)
        :Показать начальное состояние системы\nи календарь событий;
    endif

    while (Есть события в календаре?) is (да)

        |Симуляция|

        if (Пошаговый режим?) then (да)

            :Ожидать команду пользователя;

            if (Введено q?) then (да)

                :Остановить моделирование;

                |main.py|
                :Вернуться в главное меню;
                stop

            endif

        endif

        |Календарь событий|
        :Извлечь ближайшее событие\nпо модельному времени;

        |Симуляция|
        :Обновить текущее модельное время;
        :Увеличить номер шага;

        if (Тип события?) then (REQUEST_GENERATED)

            |Источник|
            :Создать новую заявку\n[ИБ - бесконечный источник];

            |Статистика|
            :Учесть сгенерированную заявку;

            |Диспетчер постановки|
            :Получить новую заявку;
            :Запросить начало обслуживания\nчерез диспетчер выбора;

            |Диспетчер выбора|
            :Запросить свободного мастера;

            |Пул мастеров|
            :Найти свободного мастера\nпо кольцу [Д2П2];

            if (Свободный мастер найден?) then (да)

                :Передвинуть указатель выбора\nна следующую позицию;

                |Мастер|
                :Принять заявку;
                :Сгенерировать время обслуживания\n[ПЗ1 - экспоненциальный закон];
                :Начать обслуживание;

                |Календарь событий|
                :Запланировать SERVICE_COMPLETED\nна время окончания обслуживания;

                |Статистика|
                :Учесть начало обслуживания;

            else (нет)

                |Диспетчер постановки|
                :Направить заявку в буфер;

                |Буфер|
                :Искать свободную ячейку\nпо кольцу [Д1ОЗ1];

                if (Свободное место найдено?) then (да)

                    :Поместить заявку\nв найденную ячейку;
                    :Записать время поступления в буфер;
                    :Передвинуть указатель постановки\nна следующую позицию;

                    |Статистика|
                    :Учесть постановку заявки в буфер;

                else (нет)

                    |Буфер|
                    :Найти самую старую заявку\nпо порядку поступления\n[Д1ОО3];

                    :Удалить самую старую заявку;
                    :Установить статус REJECTED;
                    :Поместить новую заявку\nна освободившееся место;
                    :Записать время поступления\nновой заявки в буфер;
                    :Передвинуть указатель постановки\nна следующую позицию;

                    |Статистика|
                    :Учесть отказ удалённой заявки;
                    :Учесть постановку новой заявки в буфер;

                endif

            endif

            |Симуляция|

            if (Создано меньше N заявок?) then (да)

                |Источник|
                :Сгенерировать интервал до следующей\nзаявки [ИЗ2 - равномерный закон];

                |Календарь событий|
                :Запланировать следующее\nсобытие REQUEST_GENERATED;

            else (нет)

                |Симуляция|
                :Прекратить генерацию новых заявок;

                note right
                Оставшиеся заявки продолжают
                обслуживаться до опустошения
                календаря событий.
                end note

            endif

        else (SERVICE_COMPLETED)

            |Мастер|
            :Завершить обслуживание заявки;
            :Освободиться;

            |Статистика|
            :Учесть завершение обслуживания;
            :Накопить данные для расчёта\nсредних значений и дисперсий;

            |Диспетчер выбора|
            :Получить уведомление\nоб освобождении мастера;
            :Проверить буфер;

            |Буфер|

            if (Буфер пуст?) then (да)

                |Диспетчер выбора|
                :Нет заявок для обслуживания;

            else (нет)

                |Буфер|
                :Выбрать последнюю поступившую\nзаявку [Д2Б2 - LIFO];
                :Удалить выбранную заявку из буфера;

                |Диспетчер выбора|
                :Запросить свободного мастера;

                |Пул мастеров|
                :Найти свободного мастера\nпо кольцу [Д2П2];
                :Передвинуть указатель выбора\nна следующую позицию;

                |Мастер|
                :Принять выбранную заявку;
                :Сгенерировать время обслуживания\n[ПЗ1 - экспоненциальный закон];
                :Начать обслуживание;

                |Календарь событий|
                :Запланировать SERVICE_COMPLETED\nна время окончания обслуживания;

                |Статистика|
                :Учесть начало обслуживания;

            endif

        endif

        |Симуляция|
        :Обновить состояние системы;

        if (Пошаговый режим?) then (да)

            :Показать текущее модельное время;
            :Показать действия диспетчеров;
            :Показать состояние источника,\nбуфера и мастеров;
            :Показать кольцевые указатели;
            :Показать текущую статистику;
            :Показать календарь событий\nв виде таблицы [ОД1];

        else (нет)

            :Продолжить моделирование\nбез остановки;

        endif

    endwhile (нет)

    |Симуляция|
    :Завершить текущий прогон;

    if (Автоматический режим?) then (да)

        |Статистика|
        :Рассчитать вероятность отказа\nи итоговые показатели;

        |Автоматический подбор|

        if (Вероятность отказа больше нуля?) then (да)

            :Рассчитать необходимое количество\nзаявок по формуле методички;

        else (нет)

            :Необходимое N не определено;

        endif

        if (Критерий точности выполнен?) then (да)

            :Завершить подбор N;
            :Повторный прогон не требуется;

        else (нет)

            if (Достигнут предел количества заявок?) then (да)

                :Сообщить, что требуемая\nточность не подтверждена;

                :Повторный прогон не требуется;

            else (нет)

                :Сохранить текущую вероятность отказа;

                if (Необходимое N определено?) then (да)

                    :Выбрать максимум из необходимого N\nи удвоенного текущего N;

                else (нет)

                    :Удвоить количество заявок N;

                endif

                :Ограничить N установленным пределом;
                :Подготовить повторный прогон\nс новым количеством заявок;

            endif

        endif

    else (нет)

        |Симуляция|
        :Пошаговый режим завершён;
        :Повторный прогон не требуется;

    endif

    |Симуляция|

repeat while (Нужен повторный прогон?) is (да) not (нет)

|Статистика|
:Рассчитать итоговую вероятность отказа;
:Рассчитать средние времена\nожидания, обслуживания и пребывания;
:Рассчитать дисперсии;

|Симуляция|
:Получить данные о мастерах;
:Создать SummaryReport;

|Итоговый отчёт|
:Рассчитать коэффициенты\nиспользования мастеров;
:Сформировать таблицу характеристик источников;
:Сформировать таблицу характеристик приборов;
:Вывести две итоговые таблицы [ОР1];

|main.py|
:Вернуться в главное меню;

stop

@enduml
