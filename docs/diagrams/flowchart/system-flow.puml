@startuml

title Сервисный центр по ремонту бытовой техники\nFlowchart с дорожками — вариант 16

start

partition "Источник" {
    :Определить интервал до следующей заявки;
    note right
      ИБ — бесконечный источник
      ИЗ2 — равномерный закон генерации
    end note

    :Сгенерировать новую заявку;
}

partition "Статистика" {
    :Учесть сгенерированную заявку;
}

partition "Диспетчер постановки" {
    :Получить новую заявку;
    :Запросить свободного мастера;
}

partition "Диспетчер выбора" {
    :Выполнить поиск свободного мастера\nпо кольцу;
    note right
      Д2П2 —
      выбор прибора по кольцу
    end note

    if (Свободный мастер найден?) then (да)

        :Выбрать первого свободного мастера\nпо кольцу;

        partition "Мастер" {
            :Принять заявку;
            :Сгенерировать время обслуживания;
            note right
              ПЗ1 —
              экспоненциальный закон
              времени обслуживания
            end note

            :Начать обслуживание;
        }

        partition "Статистика" {
            :Учесть начало обслуживания;
        }

    else (нет)

        partition "Диспетчер постановки" {
            :Передать заявку в буфер;
        }

        partition "Буфер" {
            :Искать свободное место,\nначиная с указателя;
            note right
              Д1ОЗ1 —
              постановка в буфер
              по кольцу
            end note

            if (Свободное место найдено?) then (да)

                :Поместить заявку\nв найденное место;
                :Передвинуть указатель\nна следующую позицию;

                partition "Статистика" {
                    :Учесть постановку заявки в буфер;
                }

            else (нет)

                :Буфер полностью заполнен;

                :Найти самую старую заявку;
                note right
                  Д1ОО3 —
                  выбивание самой старой
                  заявки из буфера
                end note

                :Удалить самую старую заявку;
                :Поместить новую заявку\nна освободившееся место;

                partition "Статистика" {
                    :Учесть отказ\nвыбитой заявки;
                }

            endif
        }

        partition "Мастер" {
            :Завершить текущее обслуживание;
            :Освободиться;
        }

        partition "Статистика" {
            :Учесть завершение обслуживания;
        }

        partition "Диспетчер выбора" {
            :Получить событие\nосвобождения мастера;
            :Проверить буфер;
        }

        partition "Буфер" {
            if (Буфер пуст?) then (да)

                :Заявок для обслуживания нет;

            else (нет)

                :Выбрать последнюю\nпоступившую заявку;
                note right
                  Д2Б2 —
                  LIFO
                end note

                :Удалить выбранную заявку\nиз буфера;

                partition "Диспетчер выбора" {
                    :Получить заявку из буфера;
                    :Выполнить поиск свободного мастера\nпо кольцу;
                    note right
                      Д2П2 —
                      выбор прибора по кольцу
                    end note
                }

                partition "Мастер" {
                    :Принять выбранную заявку;
                    :Сгенерировать время обслуживания;
                    note right
                      ПЗ1 —
                      экспоненциальный закон
                    end note

                    :Начать обслуживание;
                }

                partition "Статистика" {
                    :Учесть начало обслуживания;
                }

            endif
        }

    endif
}

stop

@enduml
