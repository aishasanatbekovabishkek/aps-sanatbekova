
@startuml

title Сервисный центр по ремонту бытовой техники\nБлок-схема с дорожками - вариант 16

|Симуляция|
start
:Инициализировать моделирование;
:Установить начальное модельное время;
:Создать первое событие поступления заявки;

|Календарь событий|
:Добавить событие REQUEST_GENERATED;

|Симуляция|
while (Есть события и не достигнуто\nусловие остановки?) is (да)

    |Календарь событий|
    :Извлечь ближайшее событие\nпо модельному времени;

    |Симуляция|
    :Обновить текущее модельное время;

    if (Тип события?) then (REQUEST_GENERATED)

        |Источник|
        :Создать новую заявку\n[ИБ - бесконечный источник];

        |Статистика|
        :Учесть сгенерированную заявку;

        |Диспетчер постановки|
        :Получить новую заявку;
        :Запросить начало обслуживания\nчерез диспетчер выбора;

        |Диспетчер выбора|
        :Запросить свободного мастера;

        |Пул мастеров|
        :Найти свободного мастера\nпо кольцу [Д2П2];

        if (Свободный мастер найден?) then (да)

            :Передвинуть указатель выбора\nна следующую позицию;

            |Мастер|
            :Принять заявку;
            :Сгенерировать время обслуживания\n[ПЗ1 - экспоненциальный закон];
            :Начать обслуживание;

            |Календарь событий|
            :Запланировать SERVICE_COMPLETED\nна время окончания обслуживания;

            |Статистика|
            :Учесть начало обслуживания;

        else (нет)

            |Диспетчер постановки|
            :Направить заявку в буфер;

            |Буфер|
            :Искать свободную ячейку\nпо кольцу [Д1ОЗ1];

            if (Свободное место найдено?) then (да)

                :Поместить заявку\nв найденную ячейку;
                :Записать время поступления\nв буфер;
                :Передвинуть указатель постановки\nна следующую позицию;

                |Статистика|
                :Учесть постановку заявки в буфер;

            else (нет)

                |Буфер|
                :Найти самую старую заявку\nпо времени поступления в буфер\n[Д1ОО3];
                :Удалить самую старую заявку;
                :Поместить новую заявку\nна освободившееся место;
                :Записать время поступления\nновой заявки в буфер;

                |Статистика|
                :Учесть отказ удалённой заявки;
                :Учесть постановку новой заявки\nв буфер;

            endif

        endif

        |Источник|
        :Сгенерировать интервал до следующей\nзаявки [ИЗ2 - равномерный закон];

        |Календарь событий|
        :Запланировать следующее\nсобытие REQUEST_GENERATED;

    else (SERVICE_COMPLETED)

        |Мастер|
        :Завершить обслуживание заявки;
        :Освободиться;

        |Статистика|
        :Учесть завершение обслуживания;

        |Диспетчер выбора|
        :Получить уведомление\nоб освобождении мастера;
        :Проверить буфер;

        |Буфер|
        if (Буфер пуст?) then (да)

            |Диспетчер выбора|
            :Нет заявок для обслуживания;

        else (нет)

            |Буфер|
            :Выбрать последнюю поступившую\nзаявку [Д2Б2 - LIFO];
            :Удалить выбранную заявку\nиз буфера;

            |Диспетчер выбора|
            :Запросить свободного мастера;

            |Пул мастеров|
            :Найти свободного мастера\nпо кольцу [Д2П2];
            :Передвинуть указатель выбора\nна следующую позицию;

            |Мастер|
            :Принять выбранную заявку;
            :Сгенерировать время обслуживания\n[ПЗ1 - экспоненциальный закон];
            :Начать обслуживание;

            |Календарь событий|
            :Запланировать SERVICE_COMPLETED\nна время окончания обслуживания;

            |Статистика|
            :Учесть начало обслуживания;

        endif

    endif

    |Симуляция|
    :Обновить состояние системы;

    if (Пошаговый режим?) then (да)
        :Показать модельное время,\nбуфер, мастеров, указатели\nи статистику;
        :Ожидать команду\n"Следующий шаг";
    else (нет)
        :Продолжить автоматически;
    endif

endwhile (нет)

|Статистика|
:Сформировать две итоговые таблицы\n[ОР1];

|Симуляция|
:Вывести результаты моделирования;
stop

@enduml
